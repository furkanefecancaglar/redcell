# REDCELL hosted deploy — supply NIM engine keys via env as JSON. NEVER commit real keys.
# Local dev needs none of this: it falls back to ~/nvidia-test/engines.py automatically.
REDCELL_NIM_KEYS={"nemotron":{"key":"nvapi-REPLACE_ME","model":"nvidia/nemotron-3-nano-30b-a3b"}}
# REDCELL_TARGET_ENGINE=nemotron
# REDCELL_JUDGE_ENGINE=nemotron
# REDCELL_HOST=0.0.0.0        # bind for container/hosting (default 127.0.0.1, local-only)
# REDCELL_PORT=8770
