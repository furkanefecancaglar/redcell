# RedCell API — environment. Copy to .env and fill in. All values have safe
# dev defaults in app/core/config.py; override these in production.

# --- Core ---
DEBUG=false

# --- Database ---
# Dev/test default is SQLite. Production: Postgres via asyncpg, e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/redcell
DATABASE_URL=sqlite+aiosqlite:///./redcell.db
DB_ECHO=false

# --- Redis (rate-limit / queue / cache; optional for single-process dev) ---
REDIS_URL=redis://localhost:6379/0

# --- Security (CHANGE THESE) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Rate limiting (per API key / IP, fixed window) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Input limits ---
MAX_INPUT_CHARS=20000
MAX_AGENT_PROMPT_CHARS=50000

# --- Cloudflare edge proxy (firewall/toolcheck/agentcheck 0-API surfaces) ---
CLOUDFLARE_WORKER_URL=https://redcell.redcellv1.workers.dev
# CLOUDFLARE_WORKER_API_KEY=
